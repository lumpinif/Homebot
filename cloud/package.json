{
  "name": "homebot-cloud",
  "version": "0.0.0",
  "private": true,
  "description": "homebot.fun Worker: the website (site/dist as static assets), download counts, update check, opt-in usage counts, email sign-up.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:site": "npm --prefix ../site ci && npm --prefix ../site run build",
    "check": "npm run build:site && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261025.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
