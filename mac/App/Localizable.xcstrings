    "moveOutside": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot isn’t in the Applications folder. Move it there before you turn on Open at login, so macOS still finds it later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot no está en la carpeta Aplicaciones. Muévelo allí antes de activar Abrir al iniciar sesión, para que macOS lo siga encontrando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot n’est pas dans le dossier Applications. Déplacez-le avant d’activer l’ouverture à la connexion, pour que macOS le retrouve plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot liegt nicht im Ordner „Programme“. Bewege es dorthin, bevor du „Bei Anmeldung öffnen“ einschaltest, damit macOS es auch später findet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot non è nella cartella Applicazioni. Spostalo lì prima di attivare l’apertura al login, così macOS lo ritrova anche in seguito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebot não está na pasta Aplicativos. Mova-o para lá antes de ativar Abrir no login, para o macOS continuar a encontrá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot не в папке «Программы». Переместите его туда до того, как включить открытие при входе, чтобы macOS находила его и позже."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot がアプリケーションフォルダにありません。「ログイン時に開く」をオンにする前に移動すると、macOS があとでも見つけられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot이 응용 프로그램 폴더에 없습니다. 로그인 시 열기를 켜기 전에 옮겨 두면 macOS가 나중에도 찾을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot 不在“应用程序”文件夹里。打开“登录时打开”之前请先把它移过去，这样 macOS 以后仍能找到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot 不在「應用程式」檔案夾裡。開啟「登入時打開」之前請先把它移過去，這樣 macOS 以後仍能找到它。"
          }
        }
      }
    },
