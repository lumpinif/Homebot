    "importStop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the old Homebot first: press Control-C in the Terminal window where it runs, or close that window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero detén el Homebot anterior: pulsa Control-C en la ventana de Terminal donde se ejecuta, o cierra esa ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez d’abord l’ancien Homebot : appuyez sur Contrôle-C dans la fenêtre du Terminal où il tourne, ou fermez cette fenêtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende zuerst das alte Homebot: Drücke Control-C im Terminalfenster, in dem es läuft, oder schließe dieses Fenster."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima ferma il vecchio Homebot: premi Control-C nella finestra di Terminale in cui è in esecuzione, oppure chiudi quella finestra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare primeiro o Homebot antigo: pressione Control-C na janela do Terminal em que ele roda, ou feche essa janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала остановите прежний Homebot: нажмите Control-C в окне Терминала, где он работает, или закройте это окно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に古い Homebot を止めてください：実行中のターミナルウインドウで Control-C を押すか、そのウインドウを閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이전 Homebot을 멈추세요: 실행 중인 터미널 윈도우에서 Control-C를 누르거나 그 윈도우를 닫습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先停止旧版 Homebot：在它运行的“终端”窗口里按 Control-C，或关掉那个窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先停止舊版 Homebot：在它執行的「終端機」視窗裡按 Control-C，或關掉那個視窗。"
          }
        }
      }
    },
