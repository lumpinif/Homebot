    "sleepNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac that is already asleep doesn’t wake up for Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac que ya está en reposo no se despierta para Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac déjà en veille ne se réveille pas pour Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Mac, der schon schläft, wacht für Siri nicht auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac già in stop non si riattiva per Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Mac que já está em repouso não acorda para a Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac, который уже спит, не проснётся ради Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにスリープしている Mac は Siri のために起きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 잠자기 중인 Mac은 Siri 때문에 깨어나지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经睡眠的 Mac 不会因 Siri 而唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經睡眠的 Mac 不會因 Siri 而喚醒。"
          }
        }
      }
    },
    "speakWhy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why didn’t Siri speak?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué Siri no habló?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi Siri n’a pas parlé ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum hat Siri nicht gesprochen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché Siri non ha parlato?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que a Siri não falou?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему Siri не ответила вслух?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriが話さなかったときは"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri가 말하지 않았나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 为什么没读出来？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 為什麼沒唸出來？"
          }
        }
      }
    },
    "speakWhyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone may only show the answer when Siri Responses is Automatic or silent mode is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone puede mostrar solo la respuesta si Respuestas de Siri está en Automático o el modo silencio está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone peut seulement afficher la réponse si Réponses de Siri est sur Automatique ou si le mode silencieux est activé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone zeigt die Antwort eventuell nur an, wenn Siri-Antworten auf Automatisch steht oder der Stummmodus an ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone può solo mostrare la risposta se Risposte di Siri è su Automatico o la modalità silenziosa è attiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone pode só mostrar a resposta quando Respostas da Siri está em Automático ou o modo silencioso está ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone может только показать ответ, если в «Ответах Siri» выбрано «Автоматически» или включён бесшумный режим."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriの応答が「自動」か、消音モードがオンのとき、iPhoneは答えを表示するだけのことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 응답이 ‘자동’이거나 무음 모드가 켜져 있으면 iPhone은 답을 보여 주기만 할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 回应设为“自动”或开着静音模式时，iPhone 可能只显示回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 回應設為「自動」或開著靜音模式時，iPhone 可能只顯示回答。"
          }
        }
      }
    },
    "spokenName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
