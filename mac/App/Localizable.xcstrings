            "value": "Un mensaje que el bot escribió para otra cosa podría leerse en voz alta a todos en la habitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un message que le bot a écrit pour autre chose pourrait être lu à voix haute devant tout le monde dans la pièce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Nachricht, die der Bot für etwas anderes geschrieben hat, könnte allen im Raum vorgelesen werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un messaggio che il bot ha scritto per un’altra cosa potrebbe essere letto ad alta voce a tutti nella stanza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mensagem que o bot escreveu para outra coisa pode ser lida em voz alta para todos na sala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение, которое бот написал по другому поводу, может быть прочитано вслух всем в комнате."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "bot が別の用途で書いたメッセージが、部屋にいる全員に読み上げられることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "bot이 다른 용도로 쓴 메시지가 방에 있는 모든 사람에게 소리 내어 읽힐 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "bot 为其他事情写的消息可能会被朗读给房间里的所有人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "bot 為其他事情寫的訊息可能會被朗讀給房間裡的所有人。"
          }
        }
      }
    },
