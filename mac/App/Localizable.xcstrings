    "phoneInstalled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” is on your iPhone: it has answered Siri. Make it again only for another iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” ya está en tu iPhone: ha respondido a Siri. Vuelve a crearlo solo para otro iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« {name} » est sur votre iPhone : il a déjà répondu à Siri. Refaites-le seulement pour un autre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„{name}“ ist auf deinem iPhone: Es hat Siri bereits geantwortet. Erstelle es nur für ein anderes iPhone neu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” è sul tuo iPhone: ha già risposto a Siri. Rifallo solo per un altro iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” já está no seu iPhone: já respondeu à Siri. Gere de novo só para outro iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» уже на вашем iPhone: он ответил Siri. Создавайте заново только для другого iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」は iPhone に追加済みで、Siri に応答しました。別の iPhone 用にだけ作り直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}”은(는) iPhone에 있으며 Siri에 응답했습니다. 다른 iPhone용일 때만 다시 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}”已在你的 iPhone 上，并已回答过 Siri。只有给另一台 iPhone 用时才需要重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」已在你的 iPhone 上，並已回答過 Siri。只有給另一台 iPhone 用時才需要重新製作。"
          }
        }
      }
    },
