    "replacesNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old one works until the new one is first used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anterior funciona hasta que se usa el nuevo por primera vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancien fonctionne jusqu’à la première utilisation du nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der alte funktioniert, bis der neue zum ersten Mal verwendet wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello vecchio funziona finché non usi quello nuovo la prima volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O antigo funciona até o novo ser usado pela primeira vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старая работает, пока новую не используют в первый раз."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいショートカットを最初に使うまで、古い方は動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 단축어를 처음 사용할 때까지 이전 단축어가 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧的会一直可用，直到新的第一次被使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊的會一直可用，直到新的第一次被使用。"
          }
        }
      }
    },
    "replacesNoteAnswered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old one keeps working until the new one has answered once."
          }
        },
        "es": {
