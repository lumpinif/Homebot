    "installSyncTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not on your iPhone? Both need the same Apple Account and iCloud Sync turned on: on this Mac in Shortcuts › Settings, on the iPhone in Settings › Apps › Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No está en tu iPhone? Ambos necesitan la misma cuenta de Apple y la sincronización con iCloud activada: en este Mac en Atajos › Ajustes, en el iPhone en Ajustes › Apps › Atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas sur votre iPhone ? Les deux doivent utiliser le même compte Apple avec la synchronisation iCloud activée : sur ce Mac dans Raccourcis › Réglages, sur l’iPhone dans Réglages › Apps › Raccourcis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht auf dem iPhone? Beide brauchen denselben Apple Account und eingeschaltete iCloud-Synchronisierung: auf diesem Mac unter Kurzbefehle › Einstellungen, auf dem iPhone unter Einstellungen › Apps › Kurzbefehle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è sul tuo iPhone? Servono lo stesso Apple Account e la sincronizzazione iCloud attiva: su questo Mac in Comandi Rapidi › Impostazioni, sull’iPhone in Impostazioni › App › Comandi Rapidi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está no iPhone? Os dois precisam da mesma Conta Apple e da sincronização do iCloud ativada: neste Mac em Atalhos › Ajustes, no iPhone em Ajustes › Apps › Atalhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет на iPhone? Нужны один Apple Account и включённая синхронизация iCloud: на Mac в «Быстрые команды › Настройки», на iPhone в «Настройки › Приложения › Быстрые команды»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone にない場合：両方で同じ Apple アカウントと iCloud 同期が必要です。Mac は“ショートカット › 設定”、iPhone は“設定 › アプリ › ショートカット”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에 없나요? 두 기기 모두 같은 Apple 계정과 iCloud 동기화가 필요해요. Mac은 ‘단축어 › 설정’, iPhone은 ‘설정 › 앱 › 단축어’."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上没有？两台设备需要同一个 Apple 账户并打开 iCloud 同步：Mac 上在“快捷指令 › 设置”，iPhone 上在“设置 › App › 快捷指令”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上沒有？兩台裝置需要同一個 Apple 帳號並開啟 iCloud 同步：Mac 上在「捷徑 › 設定」，iPhone 上在「設定 › App › 捷徑」。"
          }
        }
      }
    },
