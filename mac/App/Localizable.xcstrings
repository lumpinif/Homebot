    "phoneLangNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language of the “On your iPhone” steps, so they match the words on your iPhone. Siri and the Shortcuts use the Siri language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de los pasos “En tu iPhone”, para que coincidan con lo que ves en tu iPhone. Siri y los atajos usan el idioma de Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue des étapes « Sur votre iPhone », pour qu’elles correspondent à ce que vous voyez sur l’iPhone. Siri et les raccourcis utilisent la langue de Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache der Schritte „Auf deinem iPhone“, passend zu dem, was dein iPhone anzeigt. Siri und die Kurzbefehle nutzen die Siri-Sprache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua dei passaggi “Sul tuo iPhone”, perché corrispondano a ciò che vedi sull’iPhone. Siri e i comandi rapidi usano la lingua di Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma das etapas “No iPhone”, para combinarem com o que aparece no iPhone. A Siri e os atalhos usam o idioma da Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык шагов «На iPhone», чтобы они совпадали с надписями на вашем iPhone. Siri и быстрые команды используют язык Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「iPhone で」の手順の言語です。iPhoneの表示と合わせます。Siriとショートカットは Siri の言語を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone에서” 단계의 언어로, iPhone 화면의 표시와 맞춥니다. Siri와 단축어는 Siri 언어를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“在 iPhone 上”各步骤的语言，与你 iPhone 上显示的文字一致。Siri 和快捷指令使用 Siri 语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「在 iPhone 上」各步驟的語言，與你 iPhone 上顯示的文字一致。Siri 和捷徑使用 Siri 語言。"
          }
        }
      }
    },
