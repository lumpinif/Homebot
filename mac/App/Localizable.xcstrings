    "windowNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this window keeps Homebot running in the menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar esta ventana, Homebot sigue funcionando en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cette fenêtre laisse Homebot tourner dans la barre des menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dieses Fenster schließt, läuft Homebot in der Menüleiste weiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo questa finestra, Homebot resta attivo nella barra dei menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta janela mantém o Homebot rodando na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если закрыть это окно, Homebot продолжит работать в строке меню."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウを閉じても、Homebot はメニューバーで動き続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창을 닫아도 Homebot은 메뉴 막대에서 계속 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此窗口后，Homebot 会在菜单栏中继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此視窗後，Homebot 會在選單列中繼續執行。"
          }
        }
      }
    },
