    "showMenuBarNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: the menu bar stays clean and Homebot keeps answering Siri. Open Homebot again from Applications or Spotlight to see this window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: la barra de menús queda limpia y Homebot sigue respondiendo a Siri. Abre Homebot otra vez desde Aplicaciones o Spotlight para ver esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : la barre des menus reste dégagée et Homebot répond toujours à Siri. Rouvrez Homebot depuis Applications ou Spotlight pour voir cette fenêtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Die Menüleiste bleibt aufgeräumt, und Homebot antwortet weiter auf Siri. Öffne Homebot erneut über Programme oder Spotlight, um dieses Fenster zu sehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: la barra dei menu resta pulita e Homebot continua a rispondere a Siri. Riapri Homebot da Applicazioni o Spotlight per vedere questa finestra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: a barra de menus fica limpa e o Homebot continua respondendo à Siri. Abra o Homebot de novo pelos Aplicativos ou pelo Spotlight para ver esta janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: строка меню остаётся чистой, а Homebot продолжает отвечать Siri. Чтобы увидеть это окно, снова откройте Homebot из Программ или через Spotlight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ：メニューバーはすっきりしたまま、Homebot は Siri に答え続けます。このウインドウを見るには、アプリケーションか Spotlight から Homebot をもう一度開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔: 메뉴 막대는 깔끔하게 두고 Homebot은 계속 Siri에 답해요. 이 창을 보려면 응용 프로그램이나 Spotlight에서 Homebot을 다시 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后：菜单栏保持整洁，Homebot 仍会回答 Siri。要看到此窗口，请从“应用程序”或聚焦搜索再次打开 Homebot。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後：選單列保持整潔，Homebot 仍會回答 Siri。若要看到此視窗，請從「應用程式」或 Spotlight 再次打開 Homebot。"
          }
        }
      }
    },
