      }
    },
    "moveTranslocated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot is running straight from your download, so macOS keeps it in a temporary place and it can’t open at login. Quit Homebot, drag it into the Applications folder in Finder, and open it from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot se está ejecutando directamente desde la descarga, así que macOS lo guarda en un lugar temporal y no puede abrirse al iniciar sesión. Sal de Homebot, arrástralo a la carpeta Aplicaciones en el Finder y ábrelo desde allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot tourne directement depuis votre téléchargement : macOS le garde dans un emplacement temporaire et il ne peut pas s’ouvrir à la connexion. Quittez Homebot, faites-le glisser dans le dossier Applications dans le Finder, puis ouvrez-le depuis là."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot läuft direkt aus deinem Download, daher hält macOS es an einem temporären Ort, und es kann nicht bei der Anmeldung öffnen. Beende Homebot, ziehe es im Finder in den Ordner „Programme“ und öffne es dort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot è in esecuzione direttamente dal download, quindi macOS lo tiene in una posizione temporanea e non può aprirsi al login. Esci da Homebot, trascinalo nella cartella Applicazioni nel Finder e aprilo da lì."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebot está rodando direto do download, então o macOS o mantém num local temporário e ele não pode abrir no login. Encerre o Homebot, arraste-o para a pasta Aplicativos no Finder e abra-o de lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot запущен прямо из загрузки, поэтому macOS держит его во временном месте, и он не может открываться при входе. Завершите Homebot, перетащите его в папку «Программы» в Finder и откройте оттуда."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot はダウンロードした場所から直接動いているため、macOS が一時的な場所に置いており、ログイン時に開けません。Homebot を終了し、Finder でアプリケーションフォルダにドラッグして、そこから開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot이 다운로드한 위치에서 바로 실행되고 있어 macOS가 임시 위치에 두며, 로그인 시 열 수 없습니다. Homebot을 종료하고 Finder에서 응용 프로그램 폴더로 드래그한 다음 거기서 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot 正直接从下载的位置运行，macOS 把它放在临时位置，因此无法在登录时打开。请退出 Homebot，在“访达”里把它拖进“应用程序”文件夹，再从那里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot 正直接從下載的位置執行，macOS 把它放在暫時位置，因此無法在登入時打開。請結束 Homebot，在「Finder」裡把它拖進「應用程式」檔案夾，再從那裡打開。"
          }
        }
      }
    },
