            "value": "Firma con Apple e crea"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinar com a Apple e criar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписать через Apple и создать"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple で署名して作成"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 서명하고 만들기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Apple 签名并生成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Apple 簽名並建立"
          }
        }
      }
    },
    "signConsent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple signs it for iPhone and sees its phrase, your Mac’s address and an access code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple lo firma para el iPhone y ve su frase, la dirección de tu Mac y un código de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple le signe pour l’iPhone et voit sa phrase, l’adresse de votre Mac et un code d’accès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple signiert ihn fürs iPhone und sieht seinen Satz, die Adresse deines Mac und einen Zugangscode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple lo firma per l’iPhone e vede la frase, l’indirizzo del tuo Mac e un codice di accesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple o assina para o iPhone e vê a frase, o endereço do seu Mac e um código de acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple подписывает команду для iPhone и видит её фразу, адрес вашего Mac и код доступа."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 用に Apple が署名します。Apple にはフレーズ、Mac のアドレス、アクセスコードが届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone용으로 Apple이 서명해요. Apple은 문구, Mac 주소, 접근 코드를 받아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Apple 签名，iPhone 才能添加；Apple 会看到短语、Mac 地址和访问码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Apple 簽名，iPhone 才能加入；Apple 會看到短語、Mac 位址和存取碼。"
          }
        }
      }
    },
    "signNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the Shortcut to Apple. iOS imports only signed Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el atajo a Apple. iOS solo importa atajos firmados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie le raccourci à Apple. iOS n’importe que les raccourcis signés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet den Kurzbefehl an Apple. iOS importiert nur signierte Kurzbefehle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia il comando rapido ad Apple. iOS importa solo comandi rapidi firmati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia o atalho para a Apple. O iOS importa apenas atalhos assinados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет команду в Apple. iOS импортирует только подписанные команды."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを Apple に送ります。iOS は署名済みのショートカットだけを読み込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어를 Apple에 보냅니다. iOS에서는 서명된 단축어만 가져올 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会把快捷指令发送给 Apple。iOS 只能导入已签名的快捷指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會把捷徑傳送給 Apple。iOS 只能匯入已簽名的捷徑。"
          }
        }
      }
    },
    "signOffNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off — iOS won’t import the Shortcut until it’s signed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: iOS no importará el atajo hasta que esté firmado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : iOS n’importera le raccourci qu’une fois signé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus – iOS importiert den Kurzbefehl erst, wenn er signiert ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivata: iOS importa il comando rapido solo dopo la firma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: o iOS só importa o atalho depois de assinado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено — iOS не импортирует команду, пока она не подписана."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ — 署名するまで iOS はショートカットを読み込めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐 — 서명하기 전에는 iOS에서 단축어를 가져올 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭——签名之前，iOS 无法导入这个快捷指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關閉——簽名之前，iOS 無法匯入這個捷徑。"
          }
        }
      }
    },
