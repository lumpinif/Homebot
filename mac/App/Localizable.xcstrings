    "plainHttp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri reaches this Mac over plain HTTP. Use Homebot only on a home network you trust, and never forward its port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri llega a este Mac por HTTP sin cifrar. Usa Homebot solo en una red doméstica de confianza y nunca redirijas su puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri joint ce Mac en HTTP non chiffré. N’utilise Homebot que sur un réseau domestique de confiance, et ne redirige jamais son port."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri erreicht diesen Mac über unverschlüsseltes HTTP. Nutze Homebot nur in einem vertrauenswürdigen Heimnetz und leite seinen Port nie weiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri raggiunge questo Mac tramite HTTP non cifrato. Usa Homebot solo su una rete domestica fidata e non inoltrare mai la sua porta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri alcança este Mac por HTTP sem criptografia. Use o Homebot só em uma rede doméstica confiável e nunca redirecione a porta dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri обращается к этому Mac по незашифрованному HTTP. Используйте Homebot только в доверенной домашней сети и никогда не пробрасывайте его порт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri は暗号化されていない HTTP でこの Mac に届きます。信頼できる自宅のネットワークでだけ使い、ポートは決して転送しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri는 암호화되지 않은 HTTP로 이 Mac에 연결합니다. 신뢰할 수 있는 집 네트워크에서만 Homebot을 사용하고 포트를 절대 포워딩하지 마세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 通过未加密的 HTTP 连接这台 Mac。只在你信任的家庭网络中使用 Homebot，切勿转发它的端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri 透過未加密的 HTTP 連到這台 Mac。只在你信任的家庭網路中使用 Homebot，切勿轉送它的連接埠。"
          }
        }
      }
    },
