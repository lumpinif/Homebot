    "appIconNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic: White in Light, Black in Dark. Shows in the Dock and the app switcher while Homebot runs. Finder shows White, or Black with the Dark icon style."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático: blanco con apariencia clara, negro con oscura. Se ve en el Dock y en el selector de apps mientras Homebot está abierto. Finder muestra el blanco, o el negro con el estilo de icono Oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique : blanc en mode clair, noir en mode sombre. Visible dans le Dock et le sélecteur d’apps pendant que Homebot tourne. Le Finder montre le blanc, ou le noir avec le style d’icône Sombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch: Weiß im hellen, Schwarz im dunklen Erscheinungsbild. Erscheint im Dock und im App-Umschalter, solange Homebot läuft. Der Finder zeigt Weiß, mit dem Symbolstil „Dunkel“ Schwarz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico: bianco con aspetto chiaro, nero con scuro. Appare nel Dock e nel selettore app mentre Homebot è in esecuzione. Il Finder mostra il bianco, o il nero con lo stile icone Scuro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático: branco no modo claro, preto no escuro. Aparece no Dock e no alternador de apps enquanto o Homebot está aberto. O Finder mostra o branco, ou o preto com o estilo de ícone Escuro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически: белый в светлом оформлении, чёрный в тёмном. Виден в Dock и переключателе приложений, пока Homebot работает. Finder показывает белый, а со стилем значков «Тёмный» — чёрный."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動：ライトでは白、ダークでは黒。Homebot の実行中、Dock とアプリスイッチャーに表示されます。Finder では白、アイコンのスタイルが「ダーク」なら黒になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동: 라이트 모드에서는 흰색, 다크 모드에서는 검은색. Homebot이 실행 중일 때 Dock과 앱 전환기에 표시됩니다. Finder에서는 흰색이며, 아이콘 스타일이 ‘다크’이면 검은색입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动：浅色外观用白色，深色外观用黑色。Homebot 运行时显示在程序坞和应用切换器中。访达里显示白色；图标样式设为“深色”时显示黑色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動：淺色外觀用白色，深色外觀用黑色。Homebot 執行時會顯示在 Dock 和 App 切換器中。Finder 裡顯示白色；圖像樣式設為「深色」時顯示黑色。"
          }
        }
      }
    },
