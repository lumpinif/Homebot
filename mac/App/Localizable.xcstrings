    "entryBotsNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this order, up to 9. Changing them later needs no new Shortcut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este orden, hasta 9. Cambiarlos después no requiere un atajo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans cet ordre, jusqu’à 9. Les changer plus tard ne demande pas de nouveau raccourci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Reihenfolge, bis zu 9. Spätere Änderungen brauchen keinen neuen Kurzbefehl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quest’ordine, fino a 9. Cambiarli in seguito non richiede un nuovo comando rapido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta ordem, até 9. Mudar depois não exige um atalho novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом порядке, до 9. Менять их потом можно без новой быстрой команды."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この順番で最大9個。あとで変えても新しいショートカットは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 순서로 최대 9개. 나중에 바꿔도 새 단축어가 필요 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
