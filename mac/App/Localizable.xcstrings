    "installRenamed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts named it “{copy}”. Delete the copies until only “{name}” is left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos lo llamó «{copy}». Elimina las copias hasta que solo quede «{name}»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis l’a nommé « {copy} ». Supprimez les copies pour ne garder que « {name} »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle hat ihn „{copy}“ genannt. Lösche die Kopien, bis nur „{name}“ übrig ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandi Rapidi l’ha chiamata «{copy}». Elimina le copie finché resta solo «{name}»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Atalhos o chamou de “{copy}”. Apague as cópias até sobrar só “{name}”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрые команды назвали её «{copy}». Удалите копии, чтобы осталась только «{name}»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットが“{copy}”という名前にしました。“{name}”だけが残るようにコピーを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어가 이름을 ‘{copy}’(으)로 바꿨어요. ‘{name}’만 남도록 사본을 삭제하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷指令把它命名为“{copy}”。请删除副本，只保留“{name}”。"
