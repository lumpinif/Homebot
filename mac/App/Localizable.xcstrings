    "keepAwakeNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevents idle sleep only. Closing the lid, the Apple menu or a low battery still put it to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo evita el reposo por inactividad. Cerrar la tapa, el menú Apple o la batería baja lo siguen poniendo en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche seulement la mise en veille d’inactivité. Fermer l’écran, le menu Apple ou une batterie faible le mettent toujours en veille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert nur den Ruhezustand bei Inaktivität. Deckel zu, Apple-Menü oder schwacher Akku versetzen ihn trotzdem in den Ruhezustand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce solo lo stop per inattività. Chiudere il coperchio, il menu Apple o la batteria scarica lo mettono comunque in stop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só evita o repouso por inatividade. Fechar a tampa, o menu Apple ou bateria fraca ainda o põem em repouso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предотвращает только сон при простое. Закрытая крышка, меню Apple или низкий заряд всё равно усыпят его."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイドル時のスリープだけを防ぎます。蓋を閉じる、Apple メニュー、バッテリー残量低下ではスリープします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유휴 잠자기만 막습니다. 덮개를 닫거나 Apple 메뉴를 쓰거나 배터리가 부족하면 잠자기에 들어갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只阻止闲置睡眠。合上盖子、从苹果菜单选择睡眠或电量过低时仍会睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只阻止閒置睡眠。闔上螢幕、從蘋果選單選擇睡眠或電量過低時仍會睡眠。"
          }
        }
      }
    },
