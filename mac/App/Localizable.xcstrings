    "activityNone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. Ask Siri, and it shows up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada todavía. Pregunta a Siri y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l’instant. Pose une question à Siri, elle apparaîtra ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts. Frag Siri, dann erscheint es hier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente. Chiedi a Siri e comparirà qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ainda. Pergunte à Siri e aparece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока пусто. Спросите Siri, и запрос появится здесь."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もありません。Siri に聞くとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없습니다. Siri에게 물어보면 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有记录。问问 Siri，就会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有記錄。問問 Siri，就會顯示在這裡。"
          }
        }
      }
    },
    "activityNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions are kept as spoken, only on this Mac, and left out of Time Machine backups. A backup made earlier may still hold copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preguntas se guardan tal como se dijeron, solo en este Mac, y fuera de las copias de Time Machine. Una copia anterior puede contener todavía copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les questions sont gardées telles que dites, uniquement sur ce Mac, et hors des sauvegardes Time Machine. Une sauvegarde plus ancienne peut encore en contenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen werden so gespeichert, wie sie gesagt wurden, nur auf diesem Mac und nicht in Time-Machine-Backups. Ein früheres Backup kann noch Kopien enthalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le domande sono salvate così come dette, solo su questo Mac ed escluse dai backup di Time Machine. Un backup precedente può contenerne ancora copie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As perguntas ficam como foram ditas, só neste Mac, e fora dos backups do Time Machine. Um backup feito antes ainda pode ter cópias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы хранятся так, как были сказаны, только на этом Mac и не попадают в резервные копии Time Machine. Более ранняя копия может их ещё содержать."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問は話したとおりにこの Mac だけに保存され、Time Machine のバックアップから除外されます。それ以前のバックアップにはコピーが残っている場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문은 말한 그대로 이 Mac에만 저장되고 Time Machine 백업에서 제외됩니다. 그 전에 만든 백업에는 사본이 남아 있을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题按说出的原样保存，只在这台 Mac 上，并排除在 Time Machine 备份之外。更早的备份里可能仍有副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問題按說出的原樣保存，只在這台 Mac 上，並排除在 Time Machine 備份之外。更早的備份裡可能仍有副本。"
          }
        }
      }
    },
