      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a Chinese HomePod, Siri took a phrase starting with “问” as a web search, so saying it will likely fail. Tapping it always works. Pick another if you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un HomePod en chino, Siri tomó una frase que empieza por «问» como una búsqueda web, así que decirla probablemente fallará. Tocarlo siempre funciona. Si puedes, elige otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un HomePod en chinois, Siri a pris une phrase commençant par « 问 » pour une recherche web : la dire échouera probablement. Le toucher fonctionne toujours. Choisissez-en une autre si possible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem chinesischen HomePod hat Siri eine Phrase mit „问“ am Anfang als Websuche verstanden. Sprechen klappt dann wahrscheinlich nicht. Antippen funktioniert immer. Wähle möglichst eine andere."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un HomePod in cinese, Siri ha trattato una frase che inizia con «问» come una ricerca sul web, quindi dirla probabilmente non funzionerà. Toccarlo funziona sempre. Se puoi, scegline un’altra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Num HomePod em chinês, a Siri tratou uma frase que começa com “问” como uma busca na web, então dizê-la provavelmente vai falhar. Tocar nele sempre funciona. Se puder, escolha outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На китайском HomePod Siri приняла фразу, которая начинается с «问», за поиск в интернете, так что голосом это, скорее всего, не сработает. Нажатие работает всегда. По возможности выберите другую."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中国語の HomePod で、「问」で始まるフレーズは Siri に Web 検索として扱われました。話しかけるとうまくいかない可能性が高いです。タップすれば必ず動きます。できれば別のフレーズを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중국어 HomePod에서 Siri가 “问”으로 시작하는 문구를 웹 검색으로 처리했습니다. 말로는 실패할 가능성이 큽니다. 탭하면 항상 실행됩니다. 가능하면 다른 문구를 고릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在中文 HomePod 上，以“问”开头的指令曾被 Siri 当作网页搜索，说出来很可能不行。点按运行一定可以。能换就换一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在中文 HomePod 上，以「问」開頭的指令曾被 Siri 當作網頁搜尋，說出來很可能不行。點一下執行一定可以。能換就換一個。"
          }
        }
      }
    },
    "problems.unsafe-chars": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS would change this name. Leave out / \\ : and don’t start with a dot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS cambiaría este nombre. Quita / \\ : y no empieces con un punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS changerait ce nom. Retirez / \\ : et ne commencez pas par un point."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS würde diesen Namen ändern. Lass / \\ : weg und beginne nicht mit einem Punkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS cambierebbe questo nome. Togli / \\ : e non iniziare con un punto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS mudaria este nome. Tire / \\ : e não comece com um ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS изменит это имя. Уберите / \\ : и не начинайте с точки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がこの名前を変えてしまいます。/ \\ : を使わず、ピリオドで始めないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 이 이름을 바꿉니다. / \\ : 를 빼고, 마침표로 시작하지 마세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会改掉这个名字。不要用 / \\ :，也不要以句点开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 會改掉這個名字。不要用 / \\ :，也不要以句點開頭。"
          }
        }
      }
    },
    "problems.wrong-script-advice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri in this language may not hear other scripts, digits or symbols, so saying this phrase may not start the Shortcut. Tapping it always works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri en este idioma puede no oír otras escrituras, números o símbolos, así que decir esta frase puede no abrir el atajo. Tocarlo siempre funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri dans cette langue risque de ne pas entendre d’autres écritures, chiffres ou symboles : dire cette phrase peut ne pas lancer le raccourci. Le toucher fonctionne toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri in dieser Sprache hört andere Schriften, Ziffern oder Symbole oft nicht. Dann startet die Phrase den Kurzbefehl nicht. Antippen funktioniert immer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri in questa lingua può non sentire altre scritture, cifre o simboli, quindi dire questa frase può non avviare il comando rapido. Toccarlo funziona sempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri neste idioma pode não ouvir outras escritas, dígitos ou símbolos, então dizer esta frase pode não abrir o atalho. Tocar nele sempre funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri на этом языке может не расслышать другую письменность, цифры или символы, и фраза не запустит команду. Нажатие на команду работает всегда."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語の Siri は、他の文字、数字、記号を聞き取れないことがあります。話しかけてもショートカットが動かない場合があります。タップすれば必ず動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어의 Siri는 다른 문자, 숫자, 기호를 알아듣지 못할 수 있습니다. 말로는 단축어가 실행되지 않을 수 있습니다. 탭하면 항상 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这种语言的 Siri 可能听不出其他文字、数字或符号，说出来可能运行不了这个快捷指令。点按运行一定可以。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這種語言的 Siri 可能聽不出其他文字、數字或符號，說出來可能執行不了這個捷徑。點一下執行一定可以。"
          }
        }
      }
    },
    "qrNote": {
