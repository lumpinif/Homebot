    "editBotsNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies at once. The Shortcut on your iPhone stays as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al instante. El atajo del iPhone no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique tout de suite. Le raccourci de l’iPhone reste tel quel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt sofort. Der Kurzbefehl auf dem iPhone bleibt, wie er ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale subito. Il comando rapido sull’iPhone resta com’è."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale na hora. O atalho no iPhone continua igual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует сразу. Быстрая команда на iPhone не меняется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに反映されます。iPhoneのショートカットはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 적용돼요. iPhone의 단축어는 그대로예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效，iPhone 上的快捷指令不用改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效，iPhone 上的捷徑不用改。"
          }
        }
