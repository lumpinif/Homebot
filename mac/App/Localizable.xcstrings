    "botNameNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name that matches no bot makes Grok Bot create an empty one. Homebot won’t add it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el nombre no coincide con ningún bot, Grok Bot crea uno vacío. Homebot no lo añadirá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le nom ne correspond à aucun bot, Grok Bot en crée un vide. Homebot ne l’ajoutera pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt der Name zu keinem Bot, legt Grok Bot einen leeren an. Homebot fügt ihn nicht hinzu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il nome non corrisponde a nessun bot, Grok Bot ne crea uno vuoto. Homebot non lo aggiunge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome que não corresponde a nenhum bot faz o Grok Bot criar um vazio. O Homebot não o adiciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если имя не совпадает ни с одним ботом, Grok Bot создаст пустого. Homebot его не добавит."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの bot とも一致しない名前では、Grok Bot が空の bot を作成します。Homebot は追加しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 bot이 없는 이름이면 Grok Bot이 빈 bot을 만듭니다. Homebot은 추가하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称对不上任何 bot 时，Grok Bot 会新建一个空 bot。Homebot 不会添加它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱對不上任何 bot 時，Grok Bot 會建立一個空 bot。Homebot 不會加入它。"
          }
        }
      }
    },
