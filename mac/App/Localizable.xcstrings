    "confirmQuitBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri can’t reach Homebot until you open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri no podrá llegar a Homebot hasta que vuelvas a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri ne pourra pas joindre Homebot avant que tu le rouvres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri erreicht Homebot erst wieder, wenn du es öffnest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri non potrà raggiungere Homebot finché non lo riapri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Siri não alcança o Homebot até você abri-lo de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri не сможет обратиться к Homebot, пока вы снова его не откроете."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度開くまで、Siri は Homebot に届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 열 때까지 Siri가 Homebot에 연결할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次打开之前，Siri 将无法连接 Homebot。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次打開之前，Siri 將無法連到 Homebot。"
          }
        }
      }
    },
