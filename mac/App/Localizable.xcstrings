    "createBotNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes a new, empty bot in your Grok Bot account and adds it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un bot nuevo y vacío en tu cuenta de Grok Bot y lo añade aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un bot neuf et vide dans ton compte Grok Bot et l’ajoute ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt einen neuen, leeren Bot in deinem Grok-Bot-Konto und fügt ihn hier hinzu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un bot nuovo e vuoto nel tuo account Grok Bot e lo aggiunge qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um bot novo e vazio na sua conta do Grok Bot e o adiciona aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт нового пустого бота в вашем аккаунте Grok Bot и добавляет его сюда."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot のアカウントに新しい空のボットを作り、ここに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot 계정에 비어 있는 새 봇을 만들고 여기에 추가합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Grok Bot 账号里新建一个空的 Bot，并添加到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Grok Bot 帳號裡新建一個空的 Bot，並加入這裡。"
          }
        }
      }
    },
    "createdSameName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” is already in Homebot, but Grok Bot has no bot with this name any more. It may have been renamed in Grok Bot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» ya está en Homebot, pero Grok Bot ya no tiene ningún bot con este nombre. Puede que se haya renombrado en Grok Bot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« {name} » est déjà dans Homebot, mais Grok Bot n’a plus de bot de ce nom. Il a peut-être été renommé dans Grok Bot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„{name}“ ist schon in Homebot, aber Grok Bot hat keinen Bot mit diesem Namen mehr. Er wurde vielleicht in Grok Bot umbenannt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» è già in Homebot, ma Grok Bot non ha più un bot con questo nome. Forse è stato rinominato in Grok Bot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” já está no Homebot, mas o Grok Bot não tem mais um bot com este nome. Talvez ele tenha sido renomeado no Grok Bot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» уже есть в Homebot, но в Grok Bot больше нет бота с таким именем. Возможно, его переименовали в Grok Bot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」は Homebot にありますが、Grok Bot にはもうこの名前のボットがありません。Grok Bot で名前が変わった可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘{name}’은(는) 이미 Homebot에 있지만 Grok Bot에는 더 이상 이 이름의 봇이 없습니다. Grok Bot에서 이름이 바뀌었을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}”已在 Homebot 中，但 Grok Bot 里已没有这个名字的 Bot，可能已在 Grok Bot 里改了名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」已在 Homebot 中，但 Grok Bot 裡已沒有這個名稱的 Bot，可能已在 Grok Bot 裡改名。"
          }
        }
      }
    },
