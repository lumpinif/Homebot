    "conversation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep listening after each answer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir escuchando tras cada respuesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer d’écouter après chaque réponse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jeder Antwort weiter zuhören"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua ad ascoltare dopo ogni risposta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar ouvindo após cada resposta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушать дальше после каждого ответа"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えのあとも聞き続ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답한 뒤에도 계속 듣기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次回答后继续听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次回答後繼續聽"
          }
        }
      }
    },
    "conversationNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask again right after each answer. Say you’re done to end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a preguntar justo después de cada respuesta. Di que ya terminaste para acabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reposez une question juste après chaque réponse. Dites que vous avez fini pour arrêter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag direkt nach jeder Antwort weiter. Sag, dass du fertig bist, um aufzuhören."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi di nuovo subito dopo ogni risposta. Di’ che hai finito per chiudere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte de novo logo após cada resposta. Diga que terminou para encerrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивайте снова сразу после ответа. Скажите, что закончили, чтобы завершить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えのあとすぐに続けて質問できます。終わりと伝えれば終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답을 들은 뒤 바로 다시 물어볼 수 있습니다. 끝났다고 말하면 종료됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答完可以马上接着问。说你问完了就结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回答完可以馬上接著問。說你問完了就結束。"
          }
        }
      }
    },
