        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O antigo continua funcionando até o novo responder uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старая работает, пока новая не ответит хотя бы раз."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい方が一度応答するまで、古い方は動作します。"
