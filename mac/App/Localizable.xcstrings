    "entryNumberOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” sounds like another bot, a number or a yes or no: say its number instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» suena como otro bot, un número o un sí o no: di su número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« {name} » ressemble à un autre bot, à un nombre ou à oui ou non : dites plutôt son numéro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„{name}“ klingt wie ein anderer Bot, eine Zahl oder Ja oder Nein: Sag stattdessen seine Nummer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» suona come un altro bot, un numero o un sì o no: di’ il suo numero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” soa como outro bot, um número ou sim ou não: diga o número dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» звучит как другой бот, число или «да»/«нет»: назовите его номер."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」はほかのボットや数字、はい・いいえと紛らわしいので、番号で答えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘{name}’은(는) 다른 봇, 숫자 또는 예/아니요와 비슷하게 들려요. 번호로 말해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}”听起来像另一个 Bot、数字或“是/不是”：请说它的编号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」聽起來像另一個 Bot、數字或「是／不是」：請說它的編號。"
          }
        }
      }
    },
