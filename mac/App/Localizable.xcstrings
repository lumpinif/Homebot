    "updateCheckNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day, asks homebot.fun for the newest version. Sends nothing about you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día pregunta a homebot.fun por la versión más reciente. No envía nada sobre ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour, demande à homebot.fun la dernière version. N’envoie rien sur vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt einmal am Tag homebot.fun nach der neuesten Version. Sendet nichts über dich."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta al giorno chiede a homebot.fun la versione più recente. Non invia nulla su di te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia, pergunta ao homebot.fun qual é a versão mais nova. Não envia nada sobre você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день спрашивает у homebot.fun о новой версии. Ничего о вас не отправляет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 日 1 回、homebot.fun に最新バージョンを問い合わせます。あなたについての情報は送りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 한 번 homebot.fun에 최신 버전을 묻습니다. 사용자에 관한 정보는 보내지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一次向 homebot.fun 询问最新版本，不发送任何关于你的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一次向 homebot.fun 詢問最新版本，不傳送任何關於你的資訊。"
          }
        }
      }
    },
