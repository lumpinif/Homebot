    "usageShareNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps improve Homebot. Never includes your questions or anything that identifies you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a mejorar Homebot. Nunca incluye tus preguntas ni nada que te identifique."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide à améliorer Homebot. N’inclut jamais tes questions ni rien qui t’identifie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft, Homebot zu verbessern. Enthält nie deine Fragen oder etwas, das dich identifiziert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta a migliorare Homebot. Non include mai le tue domande né nulla che ti identifichi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda a melhorar o Homebot. Nunca inclui suas perguntas nem nada que identifique você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогает улучшать Homebot. Никогда не включает ваши вопросы и ничего, что может вас идентифицировать."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot の改善に役立ちます。質問内容や、あなたを特定できる情報は一切含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot 개선에 도움이 돼요. 질문이나 사용자를 식별할 수 있는 정보는 절대 포함되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助改进 Homebot。绝不包含你的问题或任何能识别你身份的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "協助改進 Homebot。絕不包含你的問題或任何能識別你身分的資訊。"
          }
        }
      }
    },
