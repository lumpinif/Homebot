    "phoneTrying": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” is on your iPhone. It takes over from the old one once it has answered Siri. Make it again only for another iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» ya está en tu iPhone. Sustituye al anterior cuando haya respondido a Siri. Vuelve a crearlo solo para otro iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« {name} » est sur votre iPhone. Il remplace l’ancien dès qu’il a répondu à Siri. Refaites-le seulement pour un autre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„{name}“ ist auf deinem iPhone. Es löst das alte ab, sobald es Siri geantwortet hat. Erstelle es nur für ein anderes iPhone neu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” è sul tuo iPhone. Sostituisce quello vecchio appena avrà risposto a Siri. Rifallo solo per un altro iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” já está no seu iPhone. Ele substitui o antigo assim que responder à Siri. Gere de novo só para outro iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» уже на вашем iPhone. Она заменит старую, как только ответит Siri. Создавайте заново только для другого iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」は iPhone に追加済みです。Siri に一度応答すると古い方と入れ替わります。別の iPhone 用にだけ作り直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}”은(는) iPhone에 있습니다. Siri에 한 번 응답하면 이전 단축어를 대신합니다. 다른 iPhone용일 때만 다시 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}”已在你的 iPhone 上。它第一次回答 Siri 后就会接替旧的。只有给另一台 iPhone 用时才需要重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」已在你的 iPhone 上。它第一次回答 Siri 後就會接替舊的。只有給另一台 iPhone 用時才需要重新製作。"
          }
        }
      }
    },
    "phoneTryingFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” is on your iPhone but hasn’t answered Siri yet. Ask Siri once to finish. Make it again only for another iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» ya está en tu iPhone, pero aún no ha respondido a Siri. Pregúntale a Siri una vez para terminar. Vuelve a crearlo solo para otro iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« {name} » est sur votre iPhone mais n’a pas encore répondu à Siri. Posez une question à Siri pour terminer. Refaites-le seulement pour un autre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„{name}“ ist auf deinem iPhone, hat Siri aber noch nicht geantwortet. Frag Siri einmal, um fertig zu werden. Erstelle es nur für ein anderes iPhone neu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” è sul tuo iPhone ma non ha ancora risposto a Siri. Chiedi una volta a Siri per finire. Rifallo solo per un altro iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}” já está no seu iPhone, mas ainda não respondeu à Siri. Pergunte uma vez à Siri para concluir. Gere de novo só para outro iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«{name}» уже на вашем iPhone, но ещё не ответила Siri. Спросите Siri один раз, чтобы закончить. Создавайте заново только для другого iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」は iPhone に追加済みですが、まだ Siri に応答していません。Siri に一度話しかけて完了してください。別の iPhone 用にだけ作り直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}”은(는) iPhone에 있지만 아직 Siri에 응답하지 않았습니다. Siri에 한 번 물어보면 완료됩니다. 다른 iPhone용일 때만 다시 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“{name}”已在你的 iPhone 上，但还没回答过 Siri。对 Siri 问一次就完成了。只有给另一台 iPhone 用时才需要重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「{name}」已在你的 iPhone 上，但還沒回答過 Siri。對 Siri 問一次就完成了。只有給另一台 iPhone 用時才需要重新製作。"
          }
        }
      }
    },
