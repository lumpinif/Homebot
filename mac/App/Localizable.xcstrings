        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri peut prendre le premier mot pour une de ses commandes. Si c’est le cas, choisissez-en un autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
