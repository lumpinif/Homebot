    "resetNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes all bots, Shortcuts, activity, logs and settings in Homebot, then starts setup again. Your bots in Grok Bot stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra todos los bots, atajos, actividad, registros y ajustes de Homebot y empieza de nuevo la configuración. Tus bots en Grok Bot se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime tous les bots, raccourcis, l’activité, les journaux et les réglages de Homebot, puis relance la configuration. Vos bots dans Grok Bot restent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle Bots, Kurzbefehle, Aktivitäten, Protokolle und Einstellungen in Homebot und startet die Einrichtung neu. Deine Bots in Grok Bot bleiben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutti i bot, i comandi rapidi, l’attività, i log e le impostazioni di Homebot, poi riavvia la configurazione. I tuoi bot in Grok Bot restano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga todos os bots, atalhos, atividade, registros e ajustes do Homebot e recomeça a configuração. Seus bots no Grok Bot continuam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет всех ботов, быстрые команды, активность, журналы и настройки Homebot и начинает настройку заново. Ваши боты в Grok Bot остаются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot のボット、ショートカット、アクティビティ、ログ、設定をすべて削除し、設定をやり直します。Grok Bot のボットはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebot의 모든 봇, 단축어, 활동, 로그, 설정을 삭제하고 설정을 다시 시작해요. Grok Bot의 봇은 그대로 남아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 Homebot 中的所有机器人、快捷指令、活动记录、日志和设置，然后重新开始设置。你在 Grok Bot 中的机器人会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 Homebot 中的所有機器人、捷徑、活動紀錄、日誌和設定，然後重新開始設定。你在 Grok Bot 中的機器人會保留。"
          }
        }
      }
    },
