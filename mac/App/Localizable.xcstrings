    "errors.created-new": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bot had exactly that name, so Grok Bot created an empty one. Homebot didn’t add it. Delete it in the Grok Bot app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún bot tenía exactamente ese nombre, así que Grok Bot creó uno vacío. Homebot no lo añadió. Elimínalo en la app Grok Bot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun bot n’avait exactement ce nom, donc Grok Bot en a créé un vide. Homebot ne l’a pas ajouté. Supprimez-le dans l’app Grok Bot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Bot hatte genau diesen Namen, also hat Grok Bot einen leeren erstellt. Homebot hat ihn nicht hinzugefügt. Lösche ihn in der App Grok Bot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun bot aveva esattamente quel nome, quindi Grok Bot ne ha creato uno vuoto. Homebot non lo ha aggiunto. Eliminalo nell’app Grok Bot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum bot tinha exatamente esse nome, então o Grok Bot criou um vazio. O Homebot não o adicionou. Apague-o no app Grok Bot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бота с точно таким именем не было, поэтому Grok Bot создал пустого. Homebot его не добавил. Удалите его в приложении Grok Bot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に一致する名前の bot がなかったため、Grok Bot が空の bot を作成しました。Homebot は追加していません。Grok Bot App で削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 정확히 같은 bot이 없어서 Grok Bot이 빈 bot을 만들었습니다. Homebot은 추가하지 않았습니다. Grok Bot 앱에서 삭제합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有名称完全一致的 bot，所以 Grok Bot 新建了一个空 bot。Homebot 没有添加它。请在 Grok Bot App 中删除它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有名稱完全一致的 bot，所以 Grok Bot 建立了一個空 bot。Homebot 沒有加入它。請在 Grok Bot App 中刪除它。"
          }
        }
      }
    },
