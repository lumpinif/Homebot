    "confirmResetBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts on your iPhone and Mac stop working. Delete them in the Shortcuts app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de tu iPhone y tu Mac dejan de funcionar. Elimínalos en la app Atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis de votre iPhone et de votre Mac ne fonctionneront plus. Supprimez-les dans l’app Raccourcis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle auf deinem iPhone und Mac funktionieren nicht mehr. Lösche sie in der App Kurzbefehle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi rapidi su iPhone e Mac smettono di funzionare. Eliminali nell’app Comandi Rapidi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos do seu iPhone e Mac param de funcionar. Apague-os no app Atalhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрые команды на iPhone и Mac перестанут работать. Удалите их в приложении «Быстрые команды»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone と Mac のショートカットは動かなくなります。ショートカット App で削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone과 Mac의 단축어가 더 이상 작동하지 않아요. 단축어 앱에서 삭제하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 Mac 上的快捷指令将无法使用。请在快捷指令 App 中删除它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 Mac 上的捷徑將無法使用。請在捷徑 App 中刪除它們。"
          }
        }
      }
    },
