    "problems.bad-start-advice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri may treat the first word as its own command. If it does, pick another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri puede tomar la primera palabra como una orden suya. Si lo hace, elige otra."
          }
